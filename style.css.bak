@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap');
:root{--paper:#f7f1e8;--paper2:#efe6db;--ink:#3a312b;--muted:#81766d;--gold:#b7833c;--line:rgba(102,76,52,.34);--accent:#a98e7f;--white:#fffaf2}
*{box-sizing:border-box}html{scroll-behavior:smooth;background:#211c18;scrollbar-gutter:stable}body{margin:0;background:var(--paper);color:var(--ink);font-family:Montserrat,Arial,sans-serif;overflow-x:hidden}body.locked{overflow:hidden;scrollbar-gutter:stable}button,a{font:inherit}a{text-decoration:none;color:inherit}
/* APERTURA */
.envelope-screen{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;background:radial-gradient(circle at 50% 38%,#fffaf4 0,#f3e9dc 45%,#e3d4c3 100%);transition:opacity 2s cubic-bezier(.22,.7,.2,1),visibility 2s}.envelope-screen.hide{opacity:0;visibility:hidden;pointer-events:none}.envelope-scene{width:min(90vw,410px);text-align:center;transition:transform 1.9s cubic-bezier(.22,.7,.2,1),opacity 1.7s ease,filter 1.7s ease}.envelope-screen.opening .envelope-scene{transform:translateY(-8vh) scale(.91);opacity:.18;filter:blur(2px)}
.envelope{position:relative;width:100%;aspect-ratio:1.46/1;filter:drop-shadow(0 25px 28px rgba(67,42,19,.2));perspective:1000px}.envelope-back,.envelope-front,.envelope-flap,.envelope-paper{position:absolute;inset:0;border-radius:5px}.envelope-back{background:linear-gradient(145deg,#d6c2aa,#eadbca)}.envelope-paper{inset:9% 8%;background:#fffdf8;display:grid;place-items:center;box-shadow:0 4px 18px rgba(0,0,0,.07);color:#8d7868;letter-spacing:.18em;font-size:9px;transform:translateY(18px);opacity:0;transition:transform 1.25s cubic-bezier(.18,.76,.22,1),opacity .8s ease}.envelope-flap{background:linear-gradient(150deg,#f6eee4,#d7c3aa);clip-path:polygon(0 0,100% 0,50% 68%);transform-origin:50% 0;z-index:4;transition:transform 1.35s cubic-bezier(.18,.82,.18,1),filter 1.35s}.envelope-front{z-index:5;background:linear-gradient(145deg,#e6d4be,#f4e9dc);clip-path:polygon(0 0,50% 58%,100% 0,100% 100%,0 100%)}.envelope.open .envelope-flap{transform:rotateX(178deg);filter:brightness(1.04);z-index:1}.envelope.open .envelope-paper{transform:translateY(-5px);opacity:1}.seal{position:absolute;z-index:8;left:50%;top:52%;transform:translate(-50%,-50%);width:118px;height:118px;border:0;background:transparent;padding:0;cursor:pointer;transition:transform .5s ease,opacity .6s ease,filter .6s ease}.seal img{display:block;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 8px 12px rgba(67,38,8,.32))}.seal:hover{transform:translate(-50%,-50%) scale(1.045)}.envelope.open .seal{opacity:0;transform:translate(-50%,-50%) scale(.62) rotate(-4deg);filter:blur(2px);transition-duration:1s}.tap{margin:28px 0 0;letter-spacing:.24em;font-size:9px;color:#776d61;animation:pulse 2.2s infinite;transition:opacity 1s ease,transform 1s ease,filter 1s ease}.envelope-screen.opening .tap{opacity:0;transform:translateY(8px);filter:blur(2px)}@keyframes pulse{50%{opacity:.45}}
/* BASE */
.invitation{max-width:720px;margin:auto;opacity:0;transform:translateY(22px) scale(.996);filter:blur(5px);transition:opacity 2s cubic-bezier(.2,.7,.2,1),transform 2s cubic-bezier(.2,.7,.2,1),filter 2s ease}.invitation.show{opacity:1;transform:none;filter:none}.invitation.show .hero-monogram{animation:heroEntrance 1.8s cubic-bezier(.2,.7,.2,1) both,heroFloat 6s ease-in-out 1.8s infinite}.invitation.show .hero .eyebrow{animation:softTextIn 1.1s ease .25s both}.invitation.show .hero h1{animation:softTextIn 1.25s ease .38s both}.invitation.show .hero-date{animation:softTextIn 1.15s ease .52s both}.invitation.show .hero-copy{animation:softTextIn 1.2s ease .68s both}@keyframes heroEntrance{from{opacity:0;transform:translateY(18px) scale(.94);filter:blur(7px)}to{opacity:1;transform:none;filter:blur(0)}}@keyframes softTextIn{from{opacity:0;transform:translateY(10px);filter:blur(4px)}to{opacity:1;transform:none;filter:blur(0)}}.hero,.section{padding-left:24px;padding-right:24px}.hero{min-height:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;background:linear-gradient(180deg,#f8f2e9,#f4ede3);padding-top:72px;padding-bottom:54px}.hero:before,.hero:after{content:"";position:absolute;border:1px solid rgba(113,84,57,.18);border-radius:50%;width:190px;height:190px}.hero:before{top:-110px;left:-115px}.hero:after{bottom:-120px;right:-125px}.hero-ornament{width:90px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin-bottom:23px;position:relative}.hero-ornament span:after{content:"✦";position:absolute;left:50%;top:-9px;transform:translateX(-50%);font-size:10px;color:var(--gold)}.monogram{width:min(68vw,270px);max-height:170px;object-fit:contain;filter:drop-shadow(0 9px 15px rgba(95,60,15,.12))}.hero-monogram{animation:heroFloat 6s ease-in-out infinite}.monogram.small{width:112px;max-height:90px}@keyframes heroFloat{50%{transform:translateY(-5px)}}.eyebrow,.detail-kicker,.event-kicker,.section-title p{font-size:9px;letter-spacing:.3em;color:var(--gold);font-weight:500;margin:17px 0 7px}h1,h2,.countdown-title,.names{font-family:"Cormorant Garamond",Georgia,serif}h1{font-size:47px;line-height:1;font-weight:500;margin:0}.hero h1 em{font-style:normal;color:var(--gold);padding:0 5px}.hero-date{letter-spacing:.28em;font-size:10px;margin:17px 0 0;color:var(--muted)}.hero-copy{font-family:"Cormorant Garamond",serif;font-size:19px;line-height:1.42;max-width:430px;margin:28px auto 0;color:#665a50}.scroll-line{height:66px;width:1px;background:var(--line);position:absolute;bottom:22px;overflow:hidden}.scroll-line span{display:block;width:1px;height:24px;background:var(--gold);animation:scroll 1.8s infinite}@keyframes scroll{from{transform:translateY(-30px)}to{transform:translateY(80px)}}
.section{padding-top:74px;padding-bottom:74px;text-align:center}.intro{background:var(--paper2);border-top:1px solid rgba(90,70,45,.08);border-bottom:1px solid rgba(90,70,45,.08)}.intro-lead,.invite-text{font-family:"Cormorant Garamond",serif;font-size:21px;line-height:1.42;max-width:520px;margin:0 auto}.parents{display:grid;gap:22px;margin:34px auto;max-width:520px}.parents>div{display:grid;gap:3px}.parents strong{font-family:"Cormorant Garamond",serif;font-size:18px;font-weight:500}.invite-text{font-size:17px;color:var(--muted)}
/* COUNTDOWN */
.countdown-intro{padding:78px 24px 84px;text-align:center;background:#f4eee6}.countdown-title{font-size:23px;line-height:1.35;letter-spacing:.04em;color:#a78d7f;margin:0 0 46px}.date-row{display:grid;grid-template-columns:1fr 96px 1fr;align-items:center;gap:14px;max-width:500px;margin:auto}.date-side{font-size:11px;letter-spacing:.16em;color:#a78d7f;border-bottom:1px solid rgba(135,102,82,.38);padding-bottom:13px}.date-circle{width:96px;height:96px;border:1px solid #ad9182;border-radius:50%;display:grid;place-items:center;align-content:center;color:#9e8476;line-height:1}.date-circle small{font-size:7px;letter-spacing:.12em}.date-circle b{font-family:"Cormorant Garamond",serif;font-size:30px;font-weight:400;margin:5px 0}.date-circle span{font-size:7px;letter-spacing:.14em;margin-bottom:5px}.solo-faltan{font-family:"Cormorant Garamond",serif;color:#a78d7f;letter-spacing:.15em;font-size:13px;margin:40px 0 22px}.countdown{display:flex;justify-content:center;gap:0}.countdown div{width:82px;display:grid;gap:5px;position:relative}.countdown div:not(:last-child):after{content:"";position:absolute;right:0;top:7px;height:40px;width:1px;background:rgba(130,101,84,.22)}.countdown strong{font-family:"Cormorant Garamond",serif;font-size:31px;font-weight:400;color:#8f7568}.countdown span{font-size:6px;letter-spacing:.11em;color:#a18a7d}
/* FOTO SIN CORTE DURO */
.photo-fade{position:relative;overflow:hidden;background:#b49a8a;line-height:0;min-height:0;isolation:isolate}.photo-half{position:absolute;top:0;bottom:0;width:53%;overflow:hidden}.photo-half img{width:100%;height:100%;object-fit:cover;display:block}.photo-left{left:0;mask-image:linear-gradient(90deg,#000 0 70%,transparent 100%);-webkit-mask-image:linear-gradient(90deg,#000 0 70%,transparent 100%);z-index:1}.photo-right{right:0;mask-image:linear-gradient(90deg,transparent 0,#000 30% 100%);-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 30% 100%);z-index:2}.photo-fade:before{content:"";display:block;padding-top:34.15%}.photo-vignette{position:absolute;inset:0;z-index:3;pointer-events:none;background:linear-gradient(180deg,rgba(40,25,18,.02) 40%,rgba(169,142,127,.82) 100%)}.photo-fade-caption{position:absolute;z-index:4;left:0;right:0;bottom:0;text-align:center;color:#fff8ef;line-height:1.1;padding:82px 24px 34px}.photo-fade-caption span{display:block;font-size:9px;letter-spacing:.24em;margin-bottom:7px}.photo-fade-caption strong{font-family:"Cormorant Garamond",serif;font-size:24px;font-weight:500}.photo-complete{background:var(--paper2);padding:20px 24px 0;line-height:0;text-align:center}.photo-complete img{display:block;width:100%;height:auto;max-width:672px;margin:auto}
/* ITINERARIO */
.itinerary-section{background:#ad9587;color:#fff7ef;overflow:hidden}.section-title{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:48px}.mini-line{width:64px;height:1px;background:rgba(255,247,239,.75)}.section-title p{color:#fff7ef;margin:0;font-size:10px;letter-spacing:.23em}.timeline{position:relative;max-width:640px;margin:auto;padding:5px 0 10px}.timeline:before{content:"";position:absolute;top:0;bottom:0;left:50%;width:1px;background:rgba(255,247,239,.72);transform:translateX(-50%)}.event{position:relative;width:50%;padding:0 26px 64px;display:flex}.event-left{justify-content:flex-end;text-align:right}.event-right{margin-left:50%;text-align:left}.event-content{max-width:240px}.event-left .event-content{margin-left:auto}.line-icon{height:70px;display:grid;place-items:center;color:#fff7ef}.line-icon img{display:block;width:auto;height:66px;max-width:125px;object-fit:contain;filter:brightness(0) invert(1);opacity:.96}.line-icon.large{height:104px}.line-icon.large img{height:92px;max-width:180px;filter:none}.icon-table img{height:70px}.event-kicker{color:#fff7ef;font-family:"Cormorant Garamond",serif;font-size:16px;letter-spacing:0;margin:5px 0}.event-rule{width:100%;height:1px;background:rgba(255,247,239,.65);margin:8px 0 10px}.event time{font-size:9px;letter-spacing:.08em}.event h2{font-size:20px;font-weight:500;line-height:1.05;margin:8px 0}.event p{font-size:10px;line-height:1.55;margin:5px 0;color:rgba(255,247,239,.88)}.location-link{display:inline-block;margin-top:9px;border-bottom:1px solid rgba(255,247,239,.65);font-size:8px;letter-spacing:.16em;padding-bottom:3px}.timeline-dot{position:absolute;top:31px;width:9px;height:9px;border-radius:50%;background:#fff7ef;box-shadow:0 0 0 1px rgba(255,247,239,.22);z-index:3}.event-left .timeline-dot{right:-4px}.event-right .timeline-dot{left:-5px}.early{font-size:8px;letter-spacing:.08em;color:rgba(255,247,239,.88);margin:0}
/* DETALLES */
.details-wrap{background:#f1e8dc;padding:56px 24px}.details-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:680px;margin:auto}.detail-card{padding:34px 20px 38px;border:1px solid rgba(87,66,47,.16);text-align:center;background:rgba(255,252,247,.32);transition:transform .8s cubic-bezier(.2,.7,.2,1)}.detail-card:hover{transform:translateY(-4px)}.detail-card h2{font-size:28px;font-weight:500;line-height:1.05;margin:4px 0 9px}.detail-card p:last-child{font-size:10px;line-height:1.65;color:var(--muted);margin:0 auto;max-width:260px}.detail-card .detail-kicker{margin-top:12px}
/* PADRINOS */
.godparents{background:#faf6ef}.god-grid{display:grid;gap:34px;max-width:520px;margin:auto}.god-grid>div{display:grid;gap:4px}.god-grid span{font-size:8px;letter-spacing:.23em;color:var(--gold);margin-bottom:4px}.god-grid strong{font-family:"Cormorant Garamond",serif;font-size:18px;font-weight:500}
/* CIERRE */
.closing{padding-top:86px;padding-bottom:45px;min-height:72svh;display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(180deg,#f7f1e8,#eee4d8)}.closing h2{font-size:37px;font-weight:500;margin:18px 0 0}.closing-names{font-family:"Cormorant Garamond",serif;font-size:27px;color:var(--gold);margin:4px 0 35px}.personal-note{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:8px;letter-spacing:.08em;line-height:1.7;text-align:center}.tiny-line{width:32px;height:1px;background:var(--line)}.made{font-size:7px;letter-spacing:.18em;color:#a1988d;margin-top:50px}.made strong{color:#6f675d}
/* SCROLL REVEAL: más suave y escalonado */
.reveal{opacity:0;transform:translate3d(0,42px,0) scale(.985);filter:blur(2px);transition:opacity 1s cubic-bezier(.2,.7,.2,1),transform 1s cubic-bezier(.2,.7,.2,1),filter 1s ease}.reveal.visible{opacity:1;transform:none;filter:none}.event.reveal:nth-child(2){transition-delay:.12s}.event.reveal:nth-child(3){transition-delay:.24s}.detail-card.reveal:nth-child(2){transition-delay:.12s}.hero.reveal{transform:translateY(24px)}.hero.reveal.visible{transform:none}
@media(max-width:620px){.hero{padding-top:58px;padding-bottom:44px}.details-grid{grid-template-columns:1fr;gap:14px}.detail-card{padding:27px 20px 31px}.hero h1{font-size:43px}.countdown div{width:72px}.countdown strong{font-size:28px}.date-row{grid-template-columns:1fr 88px 1fr}.date-circle{width:88px;height:88px}.event{padding-left:18px;padding-right:18px}.event-content{max-width:205px}.event h2{font-size:18px}.photo-fade:before{padding-top:42%}.photo-fade-caption{padding-bottom:27px}.photo-fade-caption strong{font-size:21px}.photo-complete{padding-left:12px;padding-right:12px}.line-icon.large img{height:84px;max-width:160px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* CEREMONIAS: bloque detallado después de la cuenta regresiva */
.ceremony-details{background:#f4eee6;padding:42px 30px 58px;text-align:center;color:#7f695d;overflow:hidden}
.ceremony-table-art{height:170px;display:flex;align-items:flex-end;justify-content:center;margin:0 auto 18px}
.ceremony-table-art img{height:170px;width:auto;max-width:88%;object-fit:contain;filter:none}
.ceremony-details>h2{font-size:28px;font-weight:500;letter-spacing:.08em;margin:0 0 8px;color:#a78d7f}
.ceremony-block{max-width:430px;margin:28px auto 0;text-align:left}
.ceremony-kicker{font-family:"Cormorant Garamond",serif;font-style:italic;font-weight:600;letter-spacing:.08em;font-size:15px;color:#a78d7f;margin:0 0 14px;text-align:center}
.ceremony-info{display:grid;grid-template-columns:108px 1fr;gap:18px;align-items:stretch}
.ceremony-info>time{font-family:"Cormorant Garamond",serif;font-size:16px;color:#a78d7f;text-align:right;padding:8px 18px 0 0;border-right:1px solid rgba(167,141,127,.4)}
.ceremony-text h3{font-family:"Cormorant Garamond",serif;font-size:21px;line-height:1.05;font-weight:600;color:#8b7165;margin:4px 0 7px}
.ceremony-text p{font-size:10px;line-height:1.55;color:#9a8175;margin:0 0 11px}
.location-button{display:inline-flex;align-items:center;justify-content:center;min-width:154px;height:38px;padding:0 22px;border-radius:22px;background:#ad9587;color:#fffaf4;font-size:9px;font-weight:600;letter-spacing:.08em;text-decoration:none;box-shadow:0 4px 12px rgba(94,67,53,.12)}
.early-light{font-size:10px;font-style:italic;color:#9a8175;margin:30px auto 0;max-width:440px}
.itinerary-simple{display:flex;flex-direction:column;align-items:center;gap:2px}
.itinerary-simple .line-icon{height:70px}
.itinerary-simple time{font-size:9px;letter-spacing:.08em;color:#fff7ef}.itinerary-label{font-family:"Cormorant Garamond",serif;font-size:14px;letter-spacing:.04em;color:#fff7ef;margin:4px 0 1px}
.itinerary-reception .event-kicker{font-family:"Cormorant Garamond",serif;font-size:15px;letter-spacing:.03em}
.itinerary-reception .event-rule{margin:7px 0 9px}
@media(max-width:620px){
 .ceremony-details{padding-left:22px;padding-right:22px}
 .ceremony-table-art{height:150px}.ceremony-table-art img{height:150px}
 .ceremony-details>h2{font-size:25px}
 .ceremony-info{grid-template-columns:92px 1fr;gap:12px}
 .ceremony-info>time{font-size:15px;padding-right:12px}
 .ceremony-text h3{font-size:19px}
}

/* ORNAMENTOS BOTÁNICOS: movimiento sutil, sin desplazar la invitación */
.hero{overflow:hidden}
.hero:before,.hero:after{display:none}
.hero>*:not(.botanical){position:relative;z-index:1}
@keyframes botanicalSway{0%,100%{transform:rotate(-1deg) translate3d(0,0,0)}50%{transform:rotate(2deg) translate3d(2px,-4px,0)}}
@keyframes botanicalSwayReverse{0%,100%{transform:scaleX(-1) rotate(-1deg) translate3d(0,0,0)}50%{transform:scaleX(-1) rotate(2deg) translate3d(2px,-4px,0)}}

/* Quitar las líneas decorativas que cruzaban visualmente la portada */
.scroll-line,.hero-ornament{display:none!important}

/* ===== CIERRE LIMPIO V15 ===== */
/* El mensaje del domingo queda inmediatamente debajo de la última foto,
   centrado y con la misma escala visual del texto secundario. */
.next-day{
  width:100%;
  max-width:none;
  margin:0;
  padding:12px 24px 4px;
  background:var(--paper);
  color:var(--muted);
  text-align:center !important;
}
.next-day-date{
  display:block;
  width:100%;
  margin:0 auto 5px !important;
  text-align:center !important;
  font-family:Montserrat,Arial,sans-serif !important;
  font-size:10px !important;
  line-height:1.35 !important;
  letter-spacing:.10em !important;
  font-weight:400 !important;
  color:#81766d !important;
}
.next-day-copy{
  display:block;
  width:100%;
  max-width:620px;
  margin:0 auto !important;
  text-align:center !important;
  font-family:Montserrat,Arial,sans-serif !important;
  font-size:10px !important;
  line-height:1.5 !important;
  letter-spacing:0 !important;
  font-weight:400 !important;
  color:#81766d !important;
}
/* Cierre más compacto y elegante; se elimina el gran espacio vertical. */
.closing{
  min-height:auto !important;
  padding:54px 24px 42px !important;
}
.closing .monogram.small{
  width:82px !important;
  max-height:70px !important;
}
.closing h2{
  font-size:25px !important;
  line-height:1.15 !important;
  margin:12px 0 0 !important;
}
.closing-names{
  font-size:18px !important;
  line-height:1.25 !important;
  margin:3px 0 26px !important;
}
@media(max-width:620px){
  .next-day{padding:11px 18px 3px}
  .next-day-date{font-size:9px !important;letter-spacing:.09em !important}
  .next-day-copy{font-size:9px !important}
  .closing{padding:45px 20px 35px !important}
  .closing .monogram.small{width:76px !important;max-height:64px !important}
  .closing h2{font-size:23px !important}
  .closing-names{font-size:17px !important}
}


/* V16 FINAL SAFETY: el cierre no depende de estilos anteriores */
.next-day{width:100%!important;max-width:none!important;margin:0!important;padding:14px 24px 8px!important;text-align:center!important;display:flex!important;flex-direction:column!important;align-items:center!important;box-sizing:border-box!important}
.next-day .next-day-date{display:block!important;width:auto!important;max-width:100%!important;margin:0 auto 7px!important;text-align:center!important;font-family:Montserrat,Arial,sans-serif!important;font-size:13px!important;line-height:1.35!important;letter-spacing:.06em!important;font-weight:400!important;color:#81766d!important}
.next-day .next-day-copy{display:block!important;width:auto!important;max-width:620px!important;margin:0 auto!important;text-align:center!important;font-family:Montserrat,Arial,sans-serif!important;font-size:13px!important;line-height:1.5!important;letter-spacing:0!important;font-weight:400!important;color:#81766d!important}
.closing{min-height:0!important;height:auto!important;padding:38px 24px 36px!important;justify-content:flex-start!important}
.closing .monogram.small{width:72px!important;max-height:60px!important}
.closing h2{font-size:22px!important;line-height:1.15!important;margin:10px 0 0!important;text-align:center!important}
.closing .closing-names{font-size:16px!important;line-height:1.25!important;margin:3px 0 20px!important;text-align:center!important}
@media(max-width:620px){.next-day{padding:12px 18px 7px!important}.next-day .next-day-date,.next-day .next-day-copy{font-size:12px!important}.closing{padding:32px 20px 30px!important}.closing .monogram.small{width:66px!important;max-height:56px!important}.closing h2{font-size:20px!important}.closing .closing-names{font-size:15px!important}}

/* V31 — ANIMACIONES LIMPIAS: textos + pétalos */
.reveal{
  opacity:0;
  transform:translate3d(0,30px,0);
  filter:blur(2px);
  transition:opacity 1.05s ease-out, transform 1.05s cubic-bezier(.22,.7,.2,1), filter 1.05s ease-out;
  will-change:opacity,transform,filter;
}
.reveal.visible{
  opacity:1;
  transform:translate3d(0,0,0);
  filter:blur(0);
}
.event.reveal:nth-child(2), .detail-card.reveal:nth-child(2){transition-delay:.12s}
.event.reveal:nth-child(3){transition-delay:.24s}
.hero.reveal{transform:translate3d(0,24px,0)}
.hero.reveal.visible{transform:translate3d(0,0,0)}

/* La entrada del encabezado conserva la animación elegante original. */
.invitation.show .hero-monogram{
  animation:heroEntrance 1.8s cubic-bezier(.2,.7,.2,1) both,heroFloat 6s ease-in-out 1.8s infinite;
}
.invitation.show .hero .eyebrow{animation:softTextIn 1.1s ease .25s both}
.invitation.show .hero h1{animation:softTextIn 1.25s ease .38s both}
.invitation.show .hero-date{animation:softTextIn 1.15s ease .52s both}
.invitation.show .hero-copy{animation:softTextIn 1.2s ease .68s both}

/* PÉTALOS: pequeños, visibles, lentos y por encima de toda la invitación. */
.side-botanical,.ak-leaf,.botanical,.side-botanical-left,.side-botanical-right{display:none!important}
.falling-petals{
  position:fixed!important;
  inset:0!important;
  width:100vw!important;
  height:100vh!important;
  z-index:10000!important;
  pointer-events:none!important;
  overflow:hidden!important;
  visibility:hidden;
  opacity:0;
  perspective:900px;
}
.falling-petals.active{visibility:visible;opacity:1}
.falling-petal{
  position:absolute!important;
  left:var(--start-x)!important;
  top:var(--start-y)!important;
  width:var(--leaf-size)!important;
  height:var(--leaf-size)!important;
  max-width:none!important;
  max-height:none!important;
  min-width:0!important;
  min-height:0!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  display:block!important;
  object-fit:contain!important;
  opacity:var(--opacity)!important;
  pointer-events:none!important;
  transform-origin:50% 50%!important;
  mix-blend-mode:multiply!important;
  will-change:transform,opacity!important;
  backface-visibility:visible!important;
  -webkit-backface-visibility:visible!important;
  animation:akPetalFall var(--leaf-duration) linear var(--leaf-delay) infinite!important;
  animation-play-state:running!important;
}
@keyframes akPetalFall{
  0%{transform:translate3d(0,-12vh,0) rotateZ(var(--r0)) rotateY(0deg) scale(.88)}
  18%{transform:translate3d(var(--drift1),18vh,0) rotateZ(var(--r1)) rotateY(95deg) scale(1)}
  38%{transform:translate3d(var(--drift2),38vh,0) rotateZ(var(--r2)) rotateY(190deg) scale(.94)}
  58%{transform:translate3d(var(--drift3),58vh,0) rotateZ(var(--r3)) rotateY(285deg) scale(1.04)}
  78%{transform:translate3d(var(--drift4),78vh,0) rotateZ(var(--r4)) rotateY(390deg) scale(.92)}
  100%{transform:translate3d(var(--drift5),116vh,0) rotateZ(var(--r5)) rotateY(500deg) scale(.86)}
}
@media(max-width:620px){
  .falling-petal{width:var(--leaf-size-mobile)!important;height:var(--leaf-size-mobile)!important}
}
@media(prefers-reduced-motion:reduce){
  .reveal,.reveal.visible{opacity:1!important;transform:none!important;filter:none!important;transition:none!important}
  .falling-petals{display:block!important}
  .falling-petal{animation:none!important}
}
